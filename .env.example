# Copy to .env and set values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=4000
# Optional: set a strong admin token to protect FAQ management endpoints
# If set, provide the token as an Authorization header: "Bearer <token>" or as the "x-admin-token" header.
ADMIN_TOKEN=
# When using docker-compose, set a Postgres password here rather than keeping a hard-coded value in compose file
POSTGRES_PASSWORD=
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
